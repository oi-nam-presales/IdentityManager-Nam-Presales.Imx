{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "frozen-jobs-plugin",
  "sourceRoot": "projects/frozen-jobs-plugin/src",
  "implicitDependencies": [
    "qer"
  ],
  "projectType": "library",
  "prefix": "imx",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:ng-packagr",
      "options": {
        "tsConfig": "projects/frozen-jobs-plugin/tsconfig.lib.json",
        "project": "projects/frozen-jobs-plugin/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "projects/frozen-jobs-plugin/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "projects/frozen-jobs-plugin/tsconfig.lib.json"
        },
        "remote-dev": {
          "tsConfig": "projects/frozen-jobs-plugin/tsconfig.lib.json"
        },
        "remote-qs": {
          "tsConfig": "projects/frozen-jobs-plugin/tsconfig.lib.json"
        }
      },
      "outputs": [
        "{workspaceRoot}/dist/frozen-jobs-plugin"
      ]
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "main": "projects/frozen-jobs-plugin/src/test.ts",
        "tsConfig": "projects/frozen-jobs-plugin/tsconfig.spec.json",
        "karmaConfig": "projects/frozen-jobs-plugin/karma.conf.js",
        "stylePreprocessorOptions": {
          "includePaths": [
            "./node_modules",
            "./node_modules/@elemental-ui/cadence-icon",
            "./node_modules/@elemental-ui/core",
            "./shared/scss"
          ]
        }
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "projects/frozen-jobs-plugin/**/*.ts",
          "projects/frozen-jobs-plugin/**/*.html"
        ]
      }
    }
  }
}
